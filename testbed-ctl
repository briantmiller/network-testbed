#!/bin/bash

IMG=rtr
#RTR_OPTS="--network br0 --privileged -v ./daemons:/etc/frr/daemons"
RTR_OPTS="--privileged -v ./daemons:/etc/frr/daemons"
RTR_OPTS="$RTR_OPTS --cap-add=BPF --cap-add=SYS_ADMIN"
RTR_OPTS="$RTR_OPTS --security-opt label=disable"
RTR_OPTS="$RTR_OPTS --security-opt unmask=/sys/fs/bpf"
RTR_OPTS="$RTR_OPTS --security-opt seccomp=unconfined"
RTR_OPTS="$RTR_OPTS --userns=host"

#RTRS="R1:net0,wan1 R2:net0,wan2 R3:wan1,wan2 H1:net0 H2:net0"
RTRS="R1:net0,wan1 R2:net0,wan2 H1:net0 H2:net0"
BRIDGES="net0 wan1 wan2"

ENTRYPOINT='["/bin/bash", "-c", "mount -t bpf bpf /sys/fs/bpf; /usr/lib/frr/frrinit.sh start ; /usr/sbin/bpfcd -b ;tail -f /dev/null"]'

function start()
{
	for BR in $BRIDGES
	do
		ip link show type bridge | grep -q $BR || ip link add $BR type bridge && ip link set $BR up
		ip link set dev $BR type bridge mcast_querier 1
		ip link set dev $BR type bridge mcast_snooping 0
		podman network create -d bridge -o mode=unmanaged --interface-name=$BR --disable-dns --ipam-driver=none $BR
		#RTR_OPTS="$RTR_OPTS --network $BR"
	done
	echo 1 > /proc/sys/net/ipv4/ip_forward
	for RN in $RTRS
	do
		R=$(echo "$RN" | cut -f 1 -d :)
		NETS=$(echo "$RN" | cut -f 2 -d : | tr ',' ' ')
		NET_OPTS=""
		#mkdir -p /var/run/bpf/$R
		#mount -t bpf bpffs /var/run/bpf/$R
		#NET_OPS="$NET_OPTS -v /var/run/bpf/$R:/sys/fs/bpf:shared"
		NET_OPTS="$NET_OPTS --mount type=tmpfs,destination=/sys/fs/bpf,tmpfs-mode=0700 --security-opt seccomp=unconfined"
		for N in $NETS
		do
			NET_OPTS="$NET_OPTS --network $N:interface_name=$N"
		done
		#if [ -d $R-files/etc/bpfc/interfaces.d ]
		#then
		#	NET_OPTS="$NET_OPTS -v ./$R-files/etc/bpfc/interfaces.d:/etc/bpfc/interfaces.d"
		#fi
		podman run -dt --name $R \
			$RTR_OPTS \
			$NET_OPTS \
			-v ./$R.conf:/etc/frr/frr.conf \
			--hostname $R \
			--entrypoint "$ENTRYPOINT" \
			$IMG
		NETNS=$(podman inspect $R --format '{{.NetworkSettings.SandboxKey}}')
		ln -s $NETNS /var/run/netns/$R
	done
	[ ! -d logs ] && mkdir logs
	[ ! -d pids ] && mkdir pids
	for VLAN in 100 101 102 103 104
	do
		ip link add wan$VLAN type bridge
		ip link add link wan1 name wan1-$VLAN type vlan id $VLAN
		ip link add link wan2 name wan2-$VLAN type vlan id $VLAN
		ip link set wan1-$VLAN master wan$VLAN
		ip link set wan2-$VLAN master wan$VLAN
		ip link set wan1-$VLAN up
		ip link set wan2-$VLAN up
		ip link set wan$VLAN up
		ip link set dev wan$VLAN type bridge mcast_querier 1
		ip link set dev wan$VLAN type bridge mcast_snooping 0
		BW=$(( $VLAN + 1 - 100 ))
		BW=$(( $BW * 10 ))
		tc qdisc add dev wan1-$VLAN root netem \
	               rate ${BW}mbit \
        	       delay 20ms 2ms \
	               loss 0.0%
        	tc qdisc add dev wan2-$VLAN root netem \
	               rate ${BW}mbit \
        	       delay 20ms 2ms \
	               loss 0.0%
		#./tools/satnetem --up-if wan1-$VLAN --down-if wan2-$VLAN --log logs/satnetem-$VLAN.log &>/dev/null &
		#echo $! > ./pids/satnetem-$VLAN.pid
	done
	for R in R1 R2
	do
		ip netns exec $R sysctl -q -w net.ipv4.fib_multipath_hash_policy=1
	done
	#tc qdisc add dev wan1-100 root netem \
	#	rate 10mbit \
	#	delay 100ms 20ms \
	#	loss 1%
	#tc qdisc add dev wan2-100 root netem \
	#	rate 20mbit \
	#	delay 200ms 20ms \
	#	loss 0.5%
	#tune
	#./tools/satrelay wan1-100 wan2-100 15000 150000 &> satnetem.log &
}

function tune()
{
	local RN R WAN I
	for RN in R1:wan1 R2:wan2
	do
		R=${RN%%:*}; WAN=${RN#*:}
		ip netns exec $R ethtool -K $WAN tso off gso off gro off >/dev/null
		ip netns exec $R ethtool -K net0 gro off >/dev/null
		# the VLAN is created by FRR; wait for it
		for I in $(seq 30); do ip -n $R link show $WAN.100 &>/dev/null && break; sleep 1; done
		#ip -n $R link set dev $WAN.100 mtu 1492 gso_max_segs 1
		ip netns exec $R ethtool -K $WAN.100 tso off gso off gro off >/dev/null 2>&1
	done
	for R in H1 H2
	do
		ip netns exec $R ethtool -K net0 tso off gso off >/dev/null
	done
}

function stop()
{
	for VLAN in 100 101 102 103 104
	do
		ip link del wan$VLAN
		ip link del wan1-$VLAN
                ip link del wan2-$VLAN
		[ -e ./pids/satnetem-$VLAN.pid ] && { pkill -F ./pids/satnetem-$VLAN.pid; rm -f ./pids/satnetem-$VLAN.pid ;}
	done
	for RN in $RTRS
	do
		R=$(echo "$RN" | cut -f 1 -d :)
		podman stop $R && podman rm $R &
		rm -f /var/run/netns/$R
		#true
		#while [ $? -eq 0 ]
		#do
		#	umount /var/run/bpf/$R
		#	mount | grep -q /var/run/bpf/$R
		#done
	done
	wait
	for BR in $BRIDGES
        do
		podman network rm $BR
	done
}

function restart()
{
	stop
	start
}

$@
